---
interface Props {
	slotId: string;
	format?: 'auto' | 'fluid' | 'rectangle';
	responsive?: boolean;
}

const { slotId, format = 'auto', responsive = true } = Astro.props;
const publisherId = import.meta.env.PUBLIC_ADSENSE_ID;

// O componente não renderiza o anúncio caso não haja Publisher ID (ambiente de dev local sem .env, por exemplo)
---

{publisherId ? (
	<div class="ad-container">
		<ins class="adsbygoogle"
			style={responsive ? "display:block" : "display:inline-block"}
			data-ad-client={publisherId}
			data-ad-slot={slotId}
			data-ad-format={format}
			data-full-width-responsive={responsive ? "true" : "false"}></ins>
		<script is:inline>
			(adsbygoogle = window.adsbygoogle || []).push({});
		</script>
	</div>
) : (
	<!-- Espaço reservado para AdSense na estrutura (em desenvolvimento) -->
	<div class="ad-placeholder">
		<span class="placeholder-text">AdSpace: {slotId}</span>
	</div>
)}

<style>
	.ad-container {
		margin: 2rem 0;
		text-align: center;
		min-height: 100px;
		display: flex;
		justify-content: center;
		align-items: center;
		background: var(--bg-tint);
		border-radius: var(--radius-m);
	}
	.ad-placeholder {
		margin: 2rem 0;
		text-align: center;
		min-height: 100px;
		display: flex;
		justify-content: center;
		align-items: center;
		background: repeating-linear-gradient(
			45deg,
			var(--bg-tint),
			var(--bg-tint) 10px,
			rgba(255, 255, 255, 0.04) 10px,
			rgba(255, 255, 255, 0.04) 20px
		);
		border: 1px dashed var(--line-subtle);
		border-radius: var(--radius-m);
	}
	.placeholder-text {
		color: var(--text-muted);
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 1px;
	}
</style>
