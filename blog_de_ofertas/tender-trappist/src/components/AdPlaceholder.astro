---
interface Props {
  width?: string;
  height?: string;
}

const { width = "100%", height = "100px" } = Astro.props;
---
<div class="ad-placeholder" style={`width: ${width}; min-height: ${height};`}>
  <!-- Placeholder para futuro Google AdSense -->
  <span>Espaço Publicitário</span>
</div>

<style>
  .ad-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.02);
    border: 1px dashed rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    margin: 2rem auto;
    color: var(--text-muted);
    font-size: 0.8em;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
</style>
