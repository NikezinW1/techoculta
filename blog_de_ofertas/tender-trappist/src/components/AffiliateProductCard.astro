---
import { Image } from 'astro:assets';

interface Props {
	product: string;
	merchant: string;
	price: string;
	oldPrice?: string;
	discount?: string;
	affiliateUrl: string;
	image: string;
	badge?: '🏆 Melhor geral' | '💰 Melhor custo-benefício' | '💎 Premium' | '🪙 Econômico' | string;
}

const { product, merchant, price, oldPrice, discount, affiliateUrl, image, badge } = Astro.props;
---

<div class="affiliate-card">
	{badge && <div class="affiliate-badge">{badge}</div>}
	<div class="affiliate-content-wrapper">
		<div class="affiliate-image">
			<img src={image} alt={product} loading="lazy" />
		</div>
		<div class="affiliate-details">
			<h4 class="affiliate-title">{product}</h4>
			<p class="affiliate-merchant">Vendido por <strong>{merchant}</strong></p>
			
			<div class="affiliate-price-box">
				{oldPrice && <span class="old-price">{oldPrice}</span>}
				<div class="current-price-row">
					<span class="current-price">{price}</span>
					{discount && <span class="discount-tag">-{discount}</span>}
				</div>
			</div>
			
			<a href={affiliateUrl} target="_blank" rel="noopener nofollow" class="btn-buy" aria-label={`Ver oferta de ${product} na loja ${merchant}`}>
				Ver Oferta
			</a>
			<p class="affiliate-disclaimer">O preço pode sofrer alterações.</p>
		</div>
	</div>
</div>

<style>
	.affiliate-card {
		background-color: var(--bg-card);
		border: 1px solid rgba(255, 255, 255, 0.05);
		border-radius: 12px;
		padding: 1.5rem;
		margin: 2rem 0;
		position: relative;
		transition: all 0.3s ease;
		box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
	}
	.affiliate-card:hover {
		border-color: var(--accent);
		box-shadow: 0 8px 25px rgba(0, 229, 255, 0.15);
		transform: translateY(-2px);
	}
	.affiliate-badge {
		position: absolute;
		top: -12px;
		left: 20px;
		background-color: var(--accent);
		color: var(--bg-dark);
		font-weight: 800;
		font-size: 0.8rem;
		padding: 4px 12px;
		border-radius: 20px;
		text-transform: uppercase;
		box-shadow: 0 2px 10px rgba(0, 229, 255, 0.3);
		z-index: 2;
	}
	.affiliate-content-wrapper {
		display: grid;
		grid-template-columns: 140px 1fr;
		gap: 1.5rem;
		align-items: center;
	}
	.affiliate-image {
		width: 100%;
		height: 140px;
		background: #fff;
		border-radius: 8px;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0.5rem;
		overflow: hidden;
	}
	.affiliate-image img {
		max-width: 100%;
		max-height: 100%;
		object-fit: contain;
	}
	.affiliate-details {
		display: flex;
		flex-direction: column;
	}
	.affiliate-title {
		font-size: 1.2rem;
		margin: 0 0 0.4rem 0;
		color: var(--text-main);
		line-height: 1.3;
	}
	.affiliate-merchant {
		font-size: 0.85rem;
		color: var(--text-muted);
		margin: 0 0 1rem 0;
	}
	.affiliate-price-box {
		margin-bottom: 1rem;
	}
	.old-price {
		font-size: 0.9rem;
		text-decoration: line-through;
		color: var(--text-muted);
		display: block;
	}
	.current-price-row {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	.current-price {
		font-size: 1.5rem;
		font-weight: bold;
		color: #10B981; /* Verde indicando bom preço */
	}
	.discount-tag {
		background-color: #EF4444; /* Vermelho para desconto chamativo */
		color: white;
		font-size: 0.75rem;
		font-weight: bold;
		padding: 2px 6px;
		border-radius: 4px;
	}
	.btn-buy {
		display: inline-block;
		background-color: var(--accent);
		color: var(--bg-dark);
		text-align: center;
		padding: 0.8rem 1.5rem;
		border-radius: 8px;
		font-weight: 800;
		text-decoration: none;
		text-transform: uppercase;
		transition: all 0.2s ease;
		border: none;
		width: max-content;
	}
	.btn-buy:hover {
		background-color: var(--accent-dark);
	}
	.affiliate-disclaimer {
		font-size: 0.75rem;
		color: var(--text-muted);
		margin: 0.5rem 0 0 0;
		font-style: italic;
	}

	@media (max-width: 600px) {
		.affiliate-content-wrapper {
			grid-template-columns: 1fr;
		}
		.affiliate-image {
			height: 200px;
		}
		.btn-buy {
			width: 100%;
		}
	}
</style>
