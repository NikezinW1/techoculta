---
interface Props {
	name: string;
	slug: string;
	icon?: string;
}

const { name, slug, icon } = Astro.props;
---

<a href={`/categoria/${slug}/`} class="category-card">
	{icon && <span class="category-icon">{icon}</span>}
	<span class="category-name">{name}</span>
</a>

<style>
	.category-card {
		background-color: var(--bg-card);
		border: 1px solid rgba(255, 255, 255, 0.05);
		padding: 1.2rem;
		border-radius: 12px;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		text-decoration: none;
		color: var(--text-main);
		font-weight: 600;
		transition: all 0.3s ease;
		gap: 0.5rem;
		height: 100%;
		width: 150px; /* Fixed width for uniform flex wrapping */
	}
	.category-card:hover {
		border-color: var(--accent);
		transform: translateY(-4px);
		box-shadow: 0 4px 20px rgba(0, 229, 255, 0.15);
	}
	.category-icon {
		font-size: 1.8rem;
		margin-bottom: 0.2rem;
	}
	.category-name {
		font-size: 1rem;
	}
</style>
