---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2>
			<a href="/">
				<img src="/logo.png" alt="Nikezin Indica" class="site-logo" />
				<!-- Caso a imagem falhe, o alt text vai aparecer -->
			</a>
		</h2>
		<div class="internal-links">
			<HeaderLink href="/">Início</HeaderLink>
			<HeaderLink href="/blog">Ofertas</HeaderLink>
			<HeaderLink href="/about">Sobre</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: #000000; /* Fundo totalmente preto para esconder a borda preta da logo */
		border-bottom: 1px solid rgba(0, 229, 255, 0.15);
		position: sticky;
		top: 0;
		z-index: 100;
	}
	h2 {
		margin: 0;
		display: flex;
		align-items: center;
	}
	h2 a {
		display: flex;
		align-items: center;
		text-decoration: none;
		color: var(--text-main);
	}
	.site-logo {
		height: 70px;
		width: auto;
		transform: scale(1.8);
		transform-origin: center;
		transition: transform 0.2s ease;
	}
	.site-logo:hover {
		transform: scale(1.9);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 960px;
		margin: 0 auto;
	}
	nav a {
		padding: 1.2em 0.8em;
		color: var(--text-muted);
		border-bottom: 4px solid transparent;
		text-decoration: none;
		font-weight: 600;
		transition: all 0.3s ease;
	}
	nav a:hover, nav a.active {
		color: var(--accent);
		border-bottom-color: var(--accent);
		text-shadow: 0 0 8px rgba(0, 229, 255, 0.3);
	}
	@media (max-width: 720px) {
		.site-logo {
			height: 50px;
			transform: scale(1.6);
		}
		nav a {
			padding: 0.8em 0.5em;
			font-size: 0.9em;
		}
	}
</style>
