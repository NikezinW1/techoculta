---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Início</HeaderLink>
			<HeaderLink href="/blog">Ofertas</HeaderLink>
			<HeaderLink href="/about">Sobre</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: rgba(15, 23, 42, 0.8);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid rgba(0, 255, 163, 0.15);
		position: sticky;
		top: 0;
		z-index: 100;
	}
	h2 {
		margin: 0;
		font-size: 1.4em;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 1.5px;
	}
	h2 a,
	h2 a.active {
		text-decoration: none;
		color: var(--text-main);
	}
	h2 a span {
		color: var(--accent);
		text-shadow: 0 0 10px rgba(0, 255, 163, 0.4);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 960px;
		margin: 0 auto;
	}
	nav a {
		padding: 1.2em 0.8em;
		color: var(--text-muted);
		border-bottom: 4px solid transparent;
		text-decoration: none;
		font-weight: 600;
		transition: all 0.3s ease;
	}
	nav a:hover, nav a.active {
		color: var(--accent);
		border-bottom-color: var(--accent);
		text-shadow: 0 0 8px rgba(0, 255, 163, 0.3);
	}
</style>
