---
// src/components/Search.astro
---

<div id="pagefind-search"></div>
<div id="search-suggestions" style="display: none; text-align: center; margin-top: 2rem; padding: 2rem; background: var(--bg-card); border-radius: 12px; border: 1px solid rgba(255,255,255,0.05);">
	<h3 style="color: var(--text-main); margin-bottom: 0.5rem;">Não encontrou o que procurava?</h3>
	<p style="color: var(--text-muted); margin-bottom: 1.5rem;">Explore nossas categorias mais acessadas:</p>
	<div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
		<a href="/categoria/celulares/" style="padding: 0.6rem 1.2rem; border-radius: 8px; border: 1px solid var(--accent); color: var(--accent); text-decoration: none; font-weight: 600;">📱 Celulares</a>
		<a href="/categoria/hardware/" style="padding: 0.6rem 1.2rem; border-radius: 8px; border: 1px solid var(--accent); color: var(--accent); text-decoration: none; font-weight: 600;">💻 Computadores</a>
		<a href="/categoria/eletrodomesticos/" style="padding: 0.6rem 1.2rem; border-radius: 8px; border: 1px solid var(--accent); color: var(--accent); text-decoration: none; font-weight: 600;">🏠 Casa</a>
		<a href="/categoria/redes-e-wi-fi/" style="padding: 0.6rem 1.2rem; border-radius: 8px; border: 1px solid var(--accent); color: var(--accent); text-decoration: none; font-weight: 600;">📡 Redes</a>
	</div>
</div>

<!-- Pagefind JS e CSS são carregados apenas onde o componente é usado -->
<link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
<script src="/pagefind/pagefind-ui.js" is:inline></script>

<script is:inline>
	window.addEventListener('DOMContentLoaded', () => {
		if (typeof PagefindUI !== 'undefined') {
			new PagefindUI({ 
				element: "#pagefind-search",
				showSubResults: true,
				showImages: true,
				resetStyles: false,
				translations: {
					placeholder: "Pesquisar no Nikezin Indica...",
					clear_search: "Limpar",
					load_more: "Carregar mais resultados",
					search_label: "Pesquisar",
					filters_label: "Filtros",
					zero_results: "Nenhum resultado encontrado para [SEARCH_TERM]. Confira nossas categorias ou tente outra pesquisa.",
					many_results: "[COUNT] resultados encontrados para [SEARCH_TERM]",
					one_result: "[COUNT] resultado encontrado para [SEARCH_TERM]",
					alt_search: "Nenhum resultado encontrado para [SEARCH_TERM]. Mostrando resultados para [DIFFERENT_TERM] ao invés disso",
					search_suggestion: "Nenhum resultado encontrado para [SEARCH_TERM]. Tente uma das seguintes pesquisas:",
					searching: "Pesquisando por [SEARCH_TERM]..."
				}
			});

			// Pagefind automaticamente lê o parâmetro ?q= da URL.
			// Focar no input caso não haja query.
			const urlParams = new URLSearchParams(window.location.search);
			if(!urlParams.has('q')) {
				const input = document.querySelector('.pagefind-ui__search-input');
				if(input) input.focus();
			}

			// MutationObserver para detectar quando não há resultados e mostrar sugestões
			const targetNode = document.querySelector('#pagefind-search');
			const suggestions = document.getElementById('search-suggestions');
			if (targetNode && suggestions) {
				const observer = new MutationObserver(() => {
					const message = document.querySelector('.pagefind-ui__message');
					const results = document.querySelectorAll('.pagefind-ui__result');
					if (message && results.length === 0 && message.textContent.includes('Nenhum resultado')) {
						suggestions.style.display = 'block';
					} else {
						suggestions.style.display = 'none';
					}
				});
				observer.observe(targetNode, { childList: true, subtree: true });
			}
		}
	});
</script>

<style is:global>
	/* Customizações para o Pagefind misturar com o tema do site */
	:root {
		--pagefind-ui-primary: var(--accent);
		--pagefind-ui-text: var(--text-main);
		--pagefind-ui-background: var(--bg-card);
		--pagefind-ui-border: rgba(255, 255, 255, 0.1);
		--pagefind-ui-tag: rgba(0, 229, 255, 0.1);
		--pagefind-ui-border-width: 1px;
		--pagefind-ui-border-radius: 8px;
		--pagefind-ui-font: var(--font-atkinson), sans-serif;
	}
	.pagefind-ui__result-excerpt {
		color: var(--text-muted) !important;
	}
	.pagefind-ui__message {
		color: var(--text-muted) !important;
	}
	.pagefind-ui__result-title {
		font-weight: bold;
	}
</style>
