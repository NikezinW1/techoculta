---
import Icon from './Icon.astro';

interface Props {
  productName: string;
  amazonUrl?: string;
  mercadoLivreUrl?: string;
  magaluUrl?: string;
  kabumUrl?: string;
}
const { productName, amazonUrl, mercadoLivreUrl, magaluUrl, kabumUrl } = Astro.props;
---

<div class="store-buttons">
  <p class="store-buttons-label"><Icon name="cart" size={16} /> Ver preço atualizado do {productName}:</p>
  <div class="store-buttons-row">
    {amazonUrl && (
      amazonUrl === "unavailable" ? (
        <span class="store-btn store-btn-unavailable" title="Produto indisponível na Amazon no momento">Amazon (Indisponível)</span>
      ) : (
        <a href={amazonUrl} class="store-btn store-btn-amazon" target="_blank" rel="nofollow sponsored noopener">Amazon</a>
      )
    )}
    {mercadoLivreUrl && (
      mercadoLivreUrl === "unavailable" ? (
        <span class="store-btn store-btn-unavailable" title="Produto indisponível no Mercado Livre no momento">Mercado Livre (Indisponível)</span>
      ) : (
        <a href={mercadoLivreUrl} class="store-btn store-btn-ml" target="_blank" rel="nofollow sponsored noopener">Mercado Livre</a>
      )
    )}
    {magaluUrl && (
      magaluUrl === "unavailable" ? (
        <span class="store-btn store-btn-unavailable" title="Produto indisponível na Magalu no momento">Magalu (Indisponível)</span>
      ) : (
        <a href={magaluUrl} class="store-btn store-btn-magalu" target="_blank" rel="nofollow sponsored noopener">Magalu</a>
      )
    )}
    {kabumUrl && (
      kabumUrl === "unavailable" ? (
        <span class="store-btn store-btn-unavailable" title="Produto indisponível na KaBuM! no momento">KaBuM! (Indisponível)</span>
      ) : (
        <a href={kabumUrl} class="store-btn store-btn-kabum" target="_blank" rel="nofollow sponsored noopener">KaBuM!</a>
      )
    )}
  </div>
  <p class="store-buttons-disclaimer">Preço e disponibilidade podem mudar. Consulte a loja para conferir as condições atuais.</p>
</div>

<style>
  .store-buttons {
    margin: 2em 0;
    padding: 1.5em;
    background-color: var(--bg-card);
    border-radius: var(--radius-m);
    border: 1px solid var(--line-subtle);
  }
  .store-buttons-disclaimer {
    font-size: 0.8em;
    color: var(--text-muted);
    margin-top: 1.5em;
    margin-bottom: 0;
  }
  .store-buttons-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    margin-bottom: 1em;
    color: var(--text-main);
  }
  .store-buttons-label svg {
    color: var(--accent);
    flex-shrink: 0;
  }
  .store-buttons-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .store-btn {
    background-color: var(--accent);
    color: var(--text-on-accent);
    text-transform: uppercase;
    letter-spacing: 0.4px;
    text-align: center;
    vertical-align: middle;
    border-radius: var(--radius-s);
    padding: 0.6em 1.2em;
    font-weight: 700;
    line-height: 1.4;
    display: inline-block;
    text-decoration: none !important;
    box-shadow: var(--shadow-sm);
    transition: transform var(--dur-fast) var(--ease), background-color var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease);
  }
  .store-btn:hover {
    background-color: var(--accent-strong);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  
  .store-btn-unavailable {
    background-color: #334155 !important;
    color: #94a3b8 !important;
    box-shadow: none !important;
    cursor: not-allowed;
    opacity: 0.7;
  }
  .store-btn-unavailable:hover {
    transform: none !important;
    background-color: #334155 !important;
  }

  /* Cores específicas por loja */
  .store-btn-amazon {
    background-color: #ff9900;
  }
  .store-btn-amazon:hover {
    background-color: #e68a00;
  }
  
  .store-btn-ml {
    background-color: #ffe600;
    color: #1e293b;
  }
  .store-btn-ml:hover {
    background-color: #e6cf00;
  }
  
  .store-btn-magalu {
    background-color: #0086ff;
    color: white !important;
  }
  .store-btn-magalu:hover {
    background-color: #0073e6;
  }
  
  .store-btn-kabum {
    background-color: #ff6500;
    color: white !important;
  }
  .store-btn-kabum:hover {
    background-color: #e65c00;
  }
</style>