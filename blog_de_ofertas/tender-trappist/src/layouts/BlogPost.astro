---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';

type Props = CollectionEntry<'blog'>['data'] & { 
	id: string;
	headings?: { depth: number; slug: string; text: string }[];
};

const props = Astro.props;
const { 
	title, description, pubDate, updatedDate, heroImage, category, 
	author = "Equipe Nikezin Indica", pros, cons, review, relatedPosts, 
	articleType, tags, id 
} = props;

// Helper to slugify
const slugify = (text: string) => text.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/\s+/g, '-').replace(/[^\w-]+/g, '');
const categorySlug = category ? slugify(category) : '';

// JSON-LD Breadcrumb
const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{
			"@type": "ListItem",
			"position": 1,
			"name": "Início",
			"item": Astro.site?.toString()
		}
	]
};

if (category) {
	breadcrumbSchema.itemListElement.push({
		"@type": "ListItem",
		"position": 2,
		"name": category,
		"item": new URL(`/categoria/${categorySlug}/`, Astro.site).toString()
	});
	breadcrumbSchema.itemListElement.push({
		"@type": "ListItem",
		"position": 3,
		"name": title,
		"item": new URL(Astro.url.pathname, Astro.site).toString()
	});
} else {
	breadcrumbSchema.itemListElement.push({
		"@type": "ListItem",
		"position": 2,
		"name": title,
		"item": new URL(Astro.url.pathname, Astro.site).toString()
	});
}

// JSON-LD Article
const articleSchema: any = {
	"@context": "https://schema.org",
	"@type": "Article",
	"headline": title,
	"description": description,
	"image": heroImage ? new URL(heroImage.src, Astro.site).toString() : undefined,
	"datePublished": pubDate.toISOString(),
	"dateModified": updatedDate ? updatedDate.toISOString() : pubDate.toISOString(),
	"author": [{
		"@type": "Person",
		"name": author,
		"url": new URL("/sobre/", Astro.site).toString()
	}]
};

// Fetch related posts
const allPosts = await getCollection('blog');
const currentId = id || (Astro.params.slug as string);
let suggestedPosts: typeof allPosts = [];

if (relatedPosts && relatedPosts.length > 0) {
	// 1. Manually related posts
	suggestedPosts = allPosts.filter(p => relatedPosts.includes(p.id) && p.id !== currentId);
}

if (suggestedPosts.length < 3 && category) {
	// 2. Posts from the same category
	const categoryMatches = allPosts.filter(p => (p.data.category === category || (category.startsWith("Áudio") && p.data.category.startsWith("Áudio"))) && p.id !== currentId && !suggestedPosts.find(sp => sp.id === p.id));
	suggestedPosts = [...suggestedPosts, ...categoryMatches];
}

if (suggestedPosts.length < 3) {
	// 3. Recent posts as fallback
	const recents = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).filter(p => p.id !== currentId && !suggestedPosts.find(sp => sp.id === p.id));
	suggestedPosts = [...suggestedPosts, ...recents];
}

suggestedPosts = suggestedPosts.slice(0, 3);

// TOC Logic: Generate TOC only if there are enough H2/H3 headings
const showToc = props.headings && props.headings.filter(h => h.depth === 2 || h.depth === 3).length > 2;

// Check if this article uses affiliates
const hasAffiliates = articleType === 'deal' || articleType === 'guide' || (tags && tags.includes('oferta'));
---

<html lang="pt-BR">
	<head>
		<BaseHead title={`${title} | Nikezin Indica`} description={description} image={heroImage} ogType="article" />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
				max-width: 900px;
				margin: 0 auto 2rem auto;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: var(--radius-l);
				box-shadow: var(--shadow-md);
				width: 100%;
				height: auto;
			}
			.prose {
				width: 800px;
				max-width: calc(100% - 1em);
				margin: auto;
				padding: 1em 0.5em;
				color: var(--text-main);
			}
			
			/* Breadcrumbs */
			.breadcrumbs {
				font-size: 0.9em;
				color: var(--text-muted);
				margin-bottom: 2rem;
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				align-items: center;
			}
			.breadcrumbs a {
				color: var(--accent);
				text-decoration: none;
				font-weight: 600;
			}
			.breadcrumbs a:hover {
				text-decoration: underline;
			}
			.breadcrumbs span.separator {
				color: var(--text-faint);
			}

			.title {
				margin-bottom: 2em;
				text-align: left; /* Alinhamento alterado para melhor leitura editorial */
				line-height: 1.3;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
				color: var(--text-main);
				font-family: var(--font-display);
				font-size: clamp(2rem, 5vw, 2.6rem);
				letter-spacing: -0.02em;
				line-height: 1.15;
			}
			.title .summary {
				font-size: 1.2rem;
				color: var(--text-muted);
				margin-bottom: 1.5rem;
				line-height: 1.6;
			}
			.article-meta {
				margin-bottom: 1em;
				color: var(--text-muted);
				font-size: 0.95em;
				display: flex;
				gap: 15px;
				flex-wrap: wrap;
				align-items: center;
			}
			.article-meta strong {
				color: var(--text-main);
			}
			
			/* Table of Contents */
			.toc-container {
				background: var(--bg-tint);
				border: 1px solid var(--line-subtle);
				border-radius: var(--radius-m);
				padding: 1.5rem;
				margin: 2rem 0;
			}
			.toc-container h3 {
				margin-top: 0;
				font-size: 1.2rem;
				color: var(--text-main);
				margin-bottom: 1rem;
			}
			.toc-container ul {
				list-style: none;
				padding-left: 0;
				margin: 0;
			}
			.toc-container ul li {
				margin-bottom: 0.5rem;
			}
			.toc-container ul li a {
				color: var(--accent);
				text-decoration: none;
				font-size: 0.95rem;
			}
			.toc-container ul li a:hover {
				text-decoration: underline;
			}
			.toc-depth-3 {
				padding-left: 1.5rem;
				font-size: 0.9rem !important;
				color: var(--text-muted) !important;
			}

			/* Article Content - Pagefind Scope */
			.article-content {
				font-size: 1.1rem;
				line-height: 1.8;
			}
			.article-content h2 {
				margin-top: 2.5rem;
				margin-bottom: 1rem;
				color: var(--accent);
			}
			.article-content h3 {
				margin-top: 2rem;
				margin-bottom: 1rem;
			}
			
			/* Prós e Contras */
			.pros-cons-container {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1.5rem;
				margin: 2.5rem 0;
			}
			.pros-box, .cons-box {
				background-color: var(--bg-card);
				border-radius: var(--radius-l);
				padding: 1.5rem;
				border: 1px solid var(--line-subtle);
			}
			.pros-box h3 { color: var(--success); margin-top: 0; display: flex; align-items: center; gap: 8px; }
			.cons-box h3 { color: var(--danger); margin-top: 0; display: flex; align-items: center; gap: 8px; }
			.pros-box h3 svg, .cons-box h3 svg { flex-shrink: 0; }
			.pros-box ul, .cons-box ul { padding-left: 1.2rem; margin-bottom: 0; }

			/* Review Box */
			.review-box {
				background: linear-gradient(145deg, var(--bg-card), var(--bg-deep));
				border-radius: var(--radius-l);
				padding: 2rem;
				margin: 3rem 0;
				border: 1px solid var(--line-strong);
				box-shadow: var(--shadow-sm);
			}
			.review-box h3 {
				margin-top: 0;
				color: var(--accent);
				text-align: center;
				font-size: 1.8em;
				margin-bottom: 1.5rem;
			}
			.review-scores {
				display: grid;
				grid-template-columns: 1fr;
				gap: 1rem;
				margin-bottom: 2rem;
			}
			.score-item {
				display: flex;
				justify-content: space-between;
				align-items: center;
				padding-bottom: 0.5rem;
				border-bottom: 1px solid rgba(255, 255, 255, 0.05);
			}
			.score-label { font-weight: 600; }
			.score-value {
				background-color: var(--accent-soft);
				color: var(--accent);
				padding: 0.2em 0.8em;
				border-radius: var(--radius-pill);
				font-weight: bold;
			}
			.final-score {
				text-align: center;
				font-size: 1.5em;
				font-weight: bold;
				color: var(--text-on-accent);
				background-color: var(--accent);
				padding: 1rem;
				border-radius: var(--radius-m);
			}

			/* Afiliados Transparencia */
			.affiliate-disclosure {
				background-color: var(--bg-tint);
				border-left: 4px solid var(--accent);
				padding: 1rem 1.5rem;
				margin: 2rem 0;
				font-size: 0.9em;
				color: var(--text-muted);
				border-radius: 0 var(--radius-s) var(--radius-s) 0;
			}

			/* Artigos Relacionados (Leia Também) */
			.related-posts {
				margin-top: 4rem;
				padding-top: 2rem;
				border-top: 1px solid var(--line-subtle);
			}
			.related-posts h3 {
				margin-bottom: 1.5rem;
				color: var(--accent);
			}
			.related-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
				gap: 1.5rem;
			}
			.related-card {
				background-color: var(--bg-card);
				border-radius: var(--radius-m);
				overflow: hidden;
				text-decoration: none;
				border: 1px solid var(--line-subtle);
				transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease), border-color var(--dur) var(--ease);
			}
			.related-card:hover {
				transform: translateY(-4px);
				border-color: var(--line-strong);
				box-shadow: var(--shadow-md);
			}
			.related-card img {
				width: 100%;
				height: 140px;
				object-fit: cover;
			}
			.related-card-content {
				padding: 1rem;
			}
			.related-card h4 {
				margin: 0;
				font-size: 1.05em;
				color: var(--text-main);
				line-height: 1.3;
			}

			@media (max-width: 768px) {
				.pros-cons-container {
					grid-template-columns: 1fr;
				}
				.title h1 {
					font-size: 2em;
				}
				.article-content {
					font-size: 1.05rem;
				}
			}
		</style>
	</head>

	<body>
		<Header data-pagefind-ignore />
		<main>
			<article class="prose">
				{/* Breadcrumbs */}
				<nav class="breadcrumbs" aria-label="Breadcrumb" data-pagefind-ignore>
					<a href="/">Início</a> 
					{category && (
						<> <span class="separator">&gt;</span> <a href={`/categoria/${categorySlug}/`}>{category}</a> </>
					)}
					<span class="separator">&gt;</span> <span aria-current="page">{title}</span>
				</nav>

				<div class="title" data-pagefind-body>
					<h1>{title}</h1>
					{description && <p class="summary">{description}</p>}
					
					<div class="article-meta" data-pagefind-ignore>
						<span>Por <strong>{author}</strong></span>
						<span>•</span>
						<span><FormattedDate date={pubDate} /></span>
						{updatedDate && (
							<>
								<span>•</span>
								<span>Atualizado em <FormattedDate date={updatedDate} /></span>
							</>
						)}
					</div>
					
					{hasAffiliates && (
						<div class="affiliate-disclosure" data-pagefind-ignore>
							<strong>Transparência:</strong> Este artigo pode conter links de afiliados. O Nikezin Indica pode receber uma comissão por compras realizadas através desses links, sem custo extra para você.
						</div>
					)}
				</div>

				<div class="hero-image" data-pagefind-body>
					{heroImage && <Image width={900} height={450} src={heroImage} alt={title} />}
				</div>

				{/* TOC - Table of Contents */}
				{showToc && (
					<div class="toc-container" data-pagefind-ignore>
						<h3>Neste artigo:</h3>
						<ul>
							{props.headings?.filter(h => h.depth === 2 || h.depth === 3).map(heading => (
								<li>
									<a href={`#${heading.slug}`} class={`toc-depth-${heading.depth}`}>
										{heading.text}
									</a>
								</li>
							))}
						</ul>
					</div>
				)}

				{/* Conteúdo Principal (O que será indexado pelo Pagefind) */}
				<div class="article-content" data-pagefind-body>
					<slot />

					{/* Prós e Contras */}
					{(pros || cons) && (
						<div class="pros-cons-container">
							{pros && pros.length > 0 && (
								<div class="pros-box">
									<h3><Icon name="check" size={18} /> Pontos Positivos</h3>
									<ul>
										{pros.map(item => <li>{item}</li>)}
									</ul>
								</div>
							)}
							{cons && cons.length > 0 && (
								<div class="cons-box">
									<h3><Icon name="x" size={18} /> Pontos Negativos</h3>
									<ul>
										{cons.map(item => <li>{item}</li>)}
									</ul>
								</div>
							)}
						</div>
					)}

					{/* Avaliação (Review) */}
					{review && (
						<div class="review-box">
							<h3>Veredito: {title}</h3>
							<div class="review-scores">
								{review.custoBeneficio && (
									<div class="score-item">
										<span class="score-label">Custo-Benefício</span>
										<span class="score-value">{review.custoBeneficio}/10</span>
									</div>
								)}
								{review.desempenho && (
									<div class="score-item">
										<span class="score-label">Desempenho</span>
										<span class="score-value">{review.desempenho}/10</span>
									</div>
								)}
								{review.construcao && (
									<div class="score-item">
										<span class="score-label">Construção / Qualidade</span>
										<span class="score-value">{review.construcao}/10</span>
									</div>
								)}
								{review.recursos && (
									<div class="score-item">
										<span class="score-label">Recursos / Funcionalidades</span>
										<span class="score-value">{review.recursos}/10</span>
									</div>
								)}
							</div>
							<div class="final-score">
								Nota Final: {review.notaFinal} / 10
							</div>
						</div>
					)}
				</div>

				{/* Leia Também (Artigos Relacionados) */}
				{suggestedPosts.length > 0 && (
					<div class="related-posts" data-pagefind-ignore>
						<h3>Leia também:</h3>
						<div class="related-grid">
							{suggestedPosts.map(post => (
								<a href={`/blog/${post.id}/`} class="related-card">
									{post.data.heroImage && <Image width={240} height={140} src={post.data.heroImage} alt="" />}
									<div class="related-card-content">
										<h4>{post.data.title}</h4>
									</div>
								</a>
							))}
						</div>
					</div>
				)}
			</article>
		</main>
		<Footer data-pagefind-ignore />
	</body>
</html>
