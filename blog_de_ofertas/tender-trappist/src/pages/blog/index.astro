---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import Icon from '../../components/Icon.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

// Pega todos os posts do blog ordenados por data
const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<BaseHead title={`Blog & Análises - ${SITE_TITLE}`} description="Todos os artigos, análises, comparativos e guias de hardware do Nikezin Indica." />
		<style>
			main {
				width: 100%;
				max-width: 1080px;
				margin: 0 auto;
				padding: 0 1rem;
				box-sizing: border-box;
			}
			.page-title {
				text-align: center;
				margin-bottom: 0.5em;
				color: var(--text-main);
			}
			.page-subtitle {
				text-align: center;
				color: var(--text-muted);
				margin-bottom: 3em;
				font-size: 1.1em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1 class="page-title">Blog & Análises</h1>
			<p class="page-subtitle">Guia completo de hardware, periféricos, celulares e recomendações do Nikezin Indica.</p>
			
			<section>
				<ul class="articles-grid">
					{
						posts.map((post, index) => (
							<li class={`article-card${index === 0 ? ' article-card--lead' : ''}`}>
								<a href={`/blog/${post.id}/`}>
									<div class="article-card__media">
										{post.data.heroImage && (
											<Image width={720} height={360} src={post.data.heroImage} alt={post.data.title} />
										)}
									</div>
									<div class="article-card__body">
										<p class="article-card__date">
											<FormattedDate date={post.data.pubDate} />
										</p>
										<h2 class="article-card__title">{post.data.title}</h2>
										<span class="card-cta">Ler Artigo <Icon name="arrowRight" size={14} /></span>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>