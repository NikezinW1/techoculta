---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import { SITE_TITLE } from '../consts';

// Pega todos os posts do blog
const allPosts = await getCollection('blog');

// Filtra estritamente apenas os conteúdos de comparação
const comparisonPosts = allPosts
	.filter(post => {
		if (post.data.articleType === 'comparison') return true;
		return post.data.title.toLowerCase().includes(' vs ');
	})
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<BaseHead 
			title={`Comparativos - ${SITE_TITLE}`} 
			description="Análises comparativas frente a frente para ajudar você a decidir qual o melhor produto para o seu perfil e orçamento." 
		/>
		<style>
			main {
				width: 100%;
				max-width: 1080px;
				margin: 0 auto;
				padding: 0 1rem;
				box-sizing: border-box;
			}
			.page-title {
				text-align: center;
				margin-bottom: 0.3em;
				color: var(--text-main);
			}
			.page-subtitle {
				text-align: center;
				color: var(--text-muted);
				margin-bottom: 2em;
				font-size: 1.1em;
			}
			.empty-state {
				text-align: center;
				padding: 4rem 1rem;
				background: var(--bg-card);
				border-radius: var(--radius-l);
				border: 1px solid var(--line-subtle);
				margin-bottom: 3rem;
			}
			.empty-state h3 {
				color: var(--text-main);
				margin-bottom: 0.5rem;
			}
			.empty-state p {
				color: var(--text-muted);
				max-width: 500px;
				margin: 0 auto;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1 class="page-title">Comparativos</h1>
			<p class="page-subtitle">Em dúvida entre dois produtos? Nós ajudamos você a decidir com análises diretas e honestas.</p>
			
			<section>
				{
					comparisonPosts.length > 0 ? (
						<ul class="articles-grid">
							{
								comparisonPosts.map((post, index) => (
									<li class={`article-card${index === 0 ? ' article-card--lead' : ''}`}>
										<a href={`/blog/${post.id}/`}>
											<div class="article-card__media">
												{post.data.heroImage && (
													<Image width={720} height={360} src={post.data.heroImage} alt={post.data.title} />
												)}
											</div>
											<div class="article-card__body">
												{post.data.category && (
													<span class="tag tag--alt">{post.data.category}</span>
												)}
												<h3 class="article-card__title">{post.data.title}</h3>
												<span class="card-cta">Ver Comparativo <Icon name="arrowRight" size={14} /></span>
											</div>
										</a>
									</li>
								))
							}
						</ul>
					) : (
						<div class="empty-state">
							<h3>Nenhum comparativo encontrado</h3>
							<p>Ainda estamos preparando novos duelos para você.</p>
						</div>
					)
				}
			</section>
		</main>
		<Footer />
	</body>
</html>