---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import { SITE_TITLE, CONTACT_EMAIL, AUTHOR_NAME } from '../consts';
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<BaseHead title={`Contato - ${SITE_TITLE}`} description="Fale com a equipe do Nikezin Indica para dúvidas, sugestões de pauta ou parcerias comerciais." />
		<style>
			main {
				width: 100%;
				max-width: 800px;
				margin: 0 auto;
				padding: 2.5rem 1rem;
				box-sizing: border-box;
				color: var(--text-main);
			}
			h1 {
				margin-bottom: 0.5em;
				color: var(--accent);
			}
			.contact-box {
				background-color: var(--bg-card);
				border: 1px solid var(--line-subtle);
				border-radius: var(--radius-l);
				padding: 2rem;
				margin-top: 1.5rem;
			}
			p {
				line-height: 1.7;
				margin-bottom: 1.2em;
			}
			.email-badge {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				background-color: var(--accent-soft);
				border: 1px solid var(--accent);
				color: var(--accent);
				padding: 0.8rem 1.2rem;
				border-radius: var(--radius-m);
				font-size: 1.1em;
				font-weight: bold;
				margin: 1rem 0;
			}
			.email-badge a {
				color: var(--accent);
				text-decoration: none;
			}
			.email-badge a:hover {
				text-decoration: underline;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Fale Conosco</h1>
			<p>Tem alguma dúvida técnica sobre hardware, sugestão de análise de produto, correção de conteúdo ou interesse em parcerias comerciais e publieditoriais?</p>
			
			<div class="contact-box">
				<p>Você pode entrar em contato diretamente com o editor executivo <strong>{AUTHOR_NAME}</strong> pelo e-mail oficial abaixo:</p>
				
				<div class="email-badge">
					<Icon name="mail" size={20} />
					<span>E-mail oficial: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></span>
				</div>
				
				<p>Respondemos a todas as mensagens relevantes com agilidade, geralmente em até 24 a 48 horas úteis.</p>
			</div>
		</main>
		<Footer />
	</body>
</html>
