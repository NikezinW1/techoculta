---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

// Pega todos os posts
const allPosts = await getCollection('blog');
// Filtra para remover os que são estritamente ofertas (para focar em editorial)
const editorialPosts = allPosts
	.filter(post => !post.data.tags || !post.data.tags.includes('oferta'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 4); // Limita aos 4 mais recentes
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 1080px;
			}
			.hero {
				text-align: center;
				padding: 4em 0;
				margin-bottom: 2em;
				border-bottom: 1px solid rgba(255, 255, 255, 0.05);
			}
			.hero h1 {
				font-size: 4em;
				margin-bottom: 0.2em;
				background: linear-gradient(to right, #F8FAFC, var(--accent));
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
			}
			.hero p {
				font-size: 1.2em;
				color: var(--text-muted);
				max-width: 600px;
				margin: 0 auto 1em auto;
			}
			.section-title {
				margin-bottom: 1.5em;
				font-size: 1.8em;
				color: var(--text-main);
				border-left: 4px solid var(--accent);
				padding-left: 15px;
			}
			ul {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				background-color: var(--bg-card);
				border-radius: 12px;
				overflow: hidden;
				border: 1px solid rgba(255, 255, 255, 0.05);
				transition: all 0.3s ease;
			}
			ul li:hover {
				transform: translateY(-5px);
				border-color: var(--accent);
				box-shadow: var(--box-shadow);
			}
			ul li * {
				text-decoration: none;
			}
			ul li img {
				width: 100%;
				height: 240px;
				object-fit: cover;
				border-bottom: 1px solid rgba(255, 255, 255, 0.05);
				border-radius: 0;
			}
			.card-content {
				padding: 1.5rem;
			}
			.title {
				margin: 0 0 0.5rem 0;
				font-size: 1.4rem;
				line-height: 1.3;
				color: var(--text-main);
			}
			.date {
				margin: 0;
				color: var(--accent);
				font-size: 0.9em;
				font-weight: 600;
			}
			@media (max-width: 720px) {
				ul {
					grid-template-columns: 1fr;
				}
				.hero h1 {
					font-size: 3em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>Tech Oculta</h1>
				<p>O submundo da inovação, inteligência artificial e hardware. Análises profundas e ferramentas que vão transformar o seu fluxo de trabalho.</p>
			</section>

			<section>
				<h2 class="section-title">Últimos Artigos Editoriais</h2>
				<ul>
					{
						editorialPosts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage && (
										<Image width={720} height={360} src={post.data.heroImage} alt="" />
									)}
									<div class="card-content">
										<p class="date">
											<FormattedDate date={post.data.pubDate} />
										</p>
										<h4 class="title">{post.data.title}</h4>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
