---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import CategoryCard from '../components/CategoryCard.astro';
import Icon from '../components/Icon.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const displayedPosts = new Set<string>();

function getPosts(count: number, filterFn: (post: any) => boolean) {
	const posts = [];
	for (const post of allPosts) {
		if (posts.length >= count) break;
		if (!displayedPosts.has(post.id) && filterFn(post)) {
			posts.push(post);
			displayedPosts.add(post.id);
		}
	}
	return posts;
}

// 1. Destaque (Prioriza featured === true, senão pega o mais recente)
let featuredPost = getPosts(1, (p) => p.data.featured === true)[0];
if (!featuredPost) {
	featuredPost = getPosts(1, () => true)[0]; // Fallback para o mais recente
}

// 2. Aprenda Antes de Comprar (Informacional)
const informationalPosts = getPosts(3, (p) => {
	if (p.data.articleType === 'informational') return true;
	// Inferência temporária
	const titleLower = p.data.title.toLowerCase();
	return titleLower.includes('o que é') || titleLower.includes('como ') || titleLower.includes('vale a pena');
});

// 3. Comparativos
const comparisonPosts = getPosts(3, (p) => {
	if (p.data.articleType === 'comparison') return true;
	// Inferência temporária
	return p.data.title.toLowerCase().includes(' vs ');
});

// 4. Guias de Compra
const guidePosts = getPosts(3, (p) => {
	if (p.data.articleType === 'guide') return true;
	// Inferência temporária
	return p.data.title.toLowerCase().includes('melhores') || (p.data.tags && p.data.tags.includes('oferta'));
});

// 5. Recentes (Qualquer post que sobrou)
const recentPosts = getPosts(6, () => true);

const categories = [
	{ name: 'Celulares', icon: 'phone', slug: 'celulares' },
	{ name: 'Computadores', icon: 'computer', slug: 'hardware' },
	{ name: 'Games', icon: 'gamepad', slug: 'games' },
	{ name: 'Casa', icon: 'house', slug: 'eletrodomesticos' },
	{ name: 'TV & Imagem', icon: 'tv', slug: 'tv-e-imagem' },
	{ name: 'Áudio', icon: 'headphones', slug: 'audio' },
	{ name: 'Redes & Wi-Fi', icon: 'wifi', slug: 'redes-e-wi-fi' },
	{ name: 'Acessórios', icon: 'plug', slug: 'acessorios' },
];
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 100%;
				max-width: 1080px;
				margin: 0 auto;
				padding: 0 1rem;
				box-sizing: border-box;
			}
			section {
				margin-bottom: 4.5rem;
			}

			/* Hero */
			.hero {
				text-align: center;
				padding: 4.5em 0 3.5em 0;
				margin-bottom: 3rem;
				border-bottom: 1px solid var(--line-subtle);
			}
			.hero h1 {
				font-family: var(--font-display);
				font-size: clamp(2.5rem, 6vw, 4rem);
				letter-spacing: -0.03em;
				margin-bottom: 0.3em;
				background: linear-gradient(100deg, #F8FAFC 35%, var(--accent));
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				line-height: 1.05;
			}
			.hero p {
				font-size: 1.25em;
				color: var(--text-muted);
				max-width: 680px;
				margin: 0 auto 2rem auto;
				line-height: 1.6;
			}
			.hero-ctas {
				display: flex;
				gap: 1rem;
				justify-content: center;
				flex-wrap: wrap;
			}

			/* Diferenciais */
			.diferenciais {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
				gap: 2rem;
				margin-bottom: 4.5rem;
				text-align: center;
			}
			.diferencial-icon {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 52px;
				height: 52px;
				border-radius: var(--radius-l);
				background-color: var(--accent-soft);
				color: var(--accent);
				margin-bottom: 1rem;
			}
			.diferencial-item h3 {
				color: var(--text-main);
				font-family: var(--font-display);
				font-size: 1rem;
				letter-spacing: 0.1em;
				margin-bottom: 0.5rem;
			}
			.diferencial-item p {
				color: var(--text-muted);
				font-size: 0.95rem;
				margin: 0;
			}

			/* Categorias */
			.categories-grid {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 1rem;
				margin-bottom: 4rem;
			}

			/* Títulos de seção */
			.section-title {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				margin-bottom: 1.5rem;
				font-size: 1.4rem;
				font-weight: 700;
				letter-spacing: -0.02em;
				color: var(--text-main);
			}
			.section-title__icon {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 36px;
				height: 36px;
				border-radius: 10px;
				background-color: var(--accent-soft);
				color: var(--accent);
				flex-shrink: 0;
			}

			/* Featured Article */
			.featured-article {
				display: grid;
				grid-template-columns: 3fr 2fr;
				background-color: var(--bg-card);
				border-radius: var(--radius-l);
				overflow: hidden;
				border: 1px solid var(--line-subtle);
				transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease), border-color var(--dur) var(--ease);
			}
			.featured-article:hover {
				box-shadow: var(--shadow-md);
				transform: translateY(-3px);
				border-color: var(--line-strong);
			}
			.featured-media {
				display: block;
				min-height: 300px;
			}
			.featured-media img {
				width: 100%;
				height: 100%;
				min-height: inherit;
				object-fit: cover;
			}
			.featured-content {
				padding: 2rem 2rem 2rem 0;
				display: flex;
				flex-direction: column;
				justify-content: center;
			}
			.featured-content a {
				text-decoration: none;
			}
			.featured-content .title {
				font-family: var(--font-display);
				font-size: 1.7rem;
				margin: 0.5rem 0 1rem 0;
				color: var(--text-main);
				line-height: 1.25;
				letter-spacing: -0.01em;
			}
			.featured-content p.description {
				color: var(--text-muted);
				line-height: 1.6;
				margin-bottom: 1.5rem;
				font-size: 0.95rem;
			}
			.featured-content .date {
				color: var(--text-faint);
				font-size: 0.8rem;
			}

			/* Lista horizontal (Aprenda antes de comprar) */
			.articles-list {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
				gap: 1.5rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.articles-list .article-card {
				flex-direction: row;
			}
			.articles-list .article-card__media {
				flex: 0 0 36%;
			}
			.articles-list .article-card__media img {
				height: 100%;
				min-height: 150px;
				object-fit: cover;
			}
			.articles-list .article-card__body {
				justify-content: center;
			}

			/* Banner de Ofertas e Newsletter */
			.banner-box {
				background: linear-gradient(180deg, var(--bg-raised) 0%, var(--bg-deep) 100%);
				border: 1px solid var(--line-subtle);
				border-radius: var(--radius-l);
				padding: 3rem 2rem;
				text-align: center;
				margin-bottom: 4.5rem;
			}
			.banner-box h2 {
				font-family: var(--font-display);
				font-size: 1.5rem;
				color: var(--text-main);
				margin-bottom: 0.5rem;
			}
			.banner-box p {
				color: var(--text-muted);
				margin-bottom: 1.5rem;
			}

			@media (max-width: 768px) {
				.featured-article {
					grid-template-columns: 1fr;
				}
				.featured-media {
					min-height: 0;
				}
				.featured-content {
					padding: 1.5rem;
				}
				.featured-media img {
					height: 220px;
					min-height: auto;
				}
				.hero h1 {
					font-size: 2.5rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			{/* 1. HERO */}
			<section class="hero">
				<h1>Descubra. Compare. Escolha melhor.</h1>
				<p>Conteúdo, análises, comparativos e guias para ajudar você a encontrar produtos que realmente valem a pena.</p>
				<div class="hero-ctas">
					<a href="/guias-de-compra/" class="btn btn--primary">Explorar Guias de Compra</a>
					<a href="/comparativos/" class="btn btn--secondary">Ver Comparativos</a>
				</div>
			</section>

			{/* 2. DIFERENCIAIS */}
			<section class="diferenciais">
				<div class="diferencial-item">
					<span class="diferencial-icon"><Icon name="info" size={22} /></span>
					<h3>INFORMAÇÃO</h3>
					<p>Entenda antes de comprar.</p>
				</div>
				<div class="diferencial-item">
					<span class="diferencial-icon"><Icon name="scale" size={22} /></span>
					<h3>COMPARAÇÃO</h3>
					<p>Veja as diferenças que realmente importam.</p>
				</div>
				<div class="diferencial-item">
					<span class="diferencial-icon"><Icon name="star" size={22} /></span>
					<h3>RECOMENDAÇÃO</h3>
					<p>Descubra o que faz sentido para você.</p>
				</div>
			</section>

			{/* 3. CATEGORIAS */}
			<section>
				<h2 class="section-title"><span class="section-title__icon"><Icon name="grid" size={18} /></span>O que você está procurando?</h2>
				<div class="categories-grid">
					{categories.map((cat) => (
						<CategoryCard name={cat.name} slug={cat.slug} icon={cat.icon} />
					))}
				</div>
			</section>

			{/* 4. DESTAQUE */}
			{featuredPost && (
				<section>
					<h2 class="section-title"><span class="section-title__icon"><Icon name="flame" size={18} /></span>Em destaque</h2>
					<article class="featured-article">
						<a href={`/blog/${featuredPost.id}/`} class="article-card__media featured-media">
							{featuredPost.data.heroImage && (
								<Image width={800} height={400} src={featuredPost.data.heroImage} alt={featuredPost.data.title} />
							)}
						</a>
						<div class="featured-content">
							<a href={`/blog/${featuredPost.id}/`}>
								{featuredPost.data.category && <span class="tag">{featuredPost.data.category}</span>}
								<h3 class="title">{featuredPost.data.title}</h3>
								<p class="date"><FormattedDate date={featuredPost.data.pubDate} /></p>
								<p class="description">{featuredPost.data.description}</p>
								<span class="card-cta">Ler análise <Icon name="arrowRight" size={14} /></span>
							</a>
						</div>
					</article>
				</section>
			)}

			{/* 5. APRENDA ANTES DE COMPRAR */}
			{informationalPosts.length > 0 && (
				<section>
					<h2 class="section-title"><span class="section-title__icon"><Icon name="book" size={18} /></span>Aprenda antes de comprar</h2>
					<ul class="articles-list">
						{informationalPosts.map((post) => (
							<li class="article-card">
								<a href={`/blog/${post.id}/`} class="article-card__media">
									{post.data.heroImage && (
										<Image width={400} height={200} src={post.data.heroImage} alt={post.data.title} />
									)}
								</a>
								<div class="article-card__body">
									{post.data.category && <span class="tag">{post.data.category}</span>}
									<h3 class="article-card__title">{post.data.title}</h3>
									<p class="article-card__date"><FormattedDate date={post.data.pubDate} /></p>
									<span class="card-cta">Ler artigo <Icon name="arrowRight" size={14} /></span>
								</div>
							</li>
						))}
					</ul>
				</section>
			)}

			{/* 6. COMPARATIVOS */}
			{comparisonPosts.length > 0 && (
				<section>
					<h2 class="section-title"><span class="section-title__icon"><Icon name="compare" size={18} /></span>Comparativos</h2>
					<ul class="articles-grid">
						{comparisonPosts.map((post) => (
							<li class="article-card">
								<a href={`/blog/${post.id}/`}>
									<div class="article-card__media">
										{post.data.heroImage && (
											<Image width={400} height={200} src={post.data.heroImage} alt={post.data.title} />
										)}
									</div>
									<div class="article-card__body">
										{post.data.category && <span class="tag">{post.data.category}</span>}
										<h3 class="article-card__title">{post.data.title}</h3>
										<p class="article-card__date"><FormattedDate date={post.data.pubDate} /></p>
										<span class="card-cta">Ver comparativo <Icon name="arrowRight" size={14} /></span>
									</div>
								</a>
							</li>
						))}
					</ul>
				</section>
			)}

			{/* 7. GUIAS DE COMPRA */}
			{guidePosts.length > 0 && (
				<section>
					<h2 class="section-title"><span class="section-title__icon"><Icon name="cart" size={18} /></span>Guias de Compra</h2>
					<ul class="articles-grid">
						{guidePosts.map((post) => (
							<li class="article-card">
								<a href={`/blog/${post.id}/`}>
									<div class="article-card__media">
										{post.data.heroImage && (
											<Image width={400} height={200} src={post.data.heroImage} alt={post.data.title} />
										)}
									</div>
									<div class="article-card__body">
										{post.data.category && <span class="tag">{post.data.category}</span>}
										<h3 class="article-card__title">{post.data.title}</h3>
										<p class="article-card__date"><FormattedDate date={post.data.pubDate} /></p>
										<span class="card-cta">Ver guia <Icon name="arrowRight" size={14} /></span>
									</div>
								</a>
							</li>
						))}
					</ul>
				</section>
			)}

			{/* 8. CONTEÚDOS RECENTES */}
			{recentPosts.length > 0 && (
				<section>
					<h2 class="section-title"><span class="section-title__icon"><Icon name="clock" size={18} /></span>Últimas atualizações</h2>
					<ul class="articles-grid">
						{recentPosts.map((post) => (
							<li class="article-card">
								<a href={`/blog/${post.id}/`}>
									<div class="article-card__media">
										{post.data.heroImage && (
											<Image width={400} height={200} src={post.data.heroImage} alt={post.data.title} />
										)}
									</div>
									<div class="article-card__body">
										{post.data.category && <span class="tag">{post.data.category}</span>}
										<h3 class="article-card__title">{post.data.title}</h3>
										<p class="article-card__date"><FormattedDate date={post.data.pubDate} /></p>
										<span class="card-cta">Ler artigo <Icon name="arrowRight" size={14} /></span>
									</div>
								</a>
							</li>
						))}
					</ul>
				</section>
			)}

			{/* 9. OFERTAS */}
			<section class="banner-box">
				<h2>Encontrou o que procurava?</h2>
				<p>Confira nossa seleção de ofertas verificadas de produtos que recomendamos.</p>
				<a href="/ofertas/" class="btn btn--primary">Ver Ofertas Atuais</a>
			</section>

			{/* 10. NEWSLETTER */}
			<section class="banner-box" style="margin-bottom: 2rem;">
				<h2>Quer descobrir boas oportunidades?</h2>
				<p>Receba novos guias, comparativos e descobertas do Nikezin Indica.</p>
				<form class="newsletter-form" style="display: flex; gap: 1rem; justify-content: center; max-width: 500px; margin: 0 auto; flex-wrap: wrap;">
					<input type="email" placeholder="Seu melhor e-mail" aria-label="E-mail para newsletter" style="flex: 1; min-width: 200px; padding: 0.8rem 1rem; border-radius: var(--radius-s); border: 1px solid var(--line-subtle); background: var(--bg-deep); color: var(--text-main);" />
					<button type="button" class="btn btn--secondary" style="cursor: pointer;">Inscrever-se</button>
				</form>
			</section>
		</main>
		<Footer />
	</body>
</html>