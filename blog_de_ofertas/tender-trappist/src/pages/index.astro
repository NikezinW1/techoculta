---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import CategoryCard from '../components/CategoryCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const displayedPosts = new Set<string>();

function getPosts(count: number, filterFn: (post: any) => boolean) {
	const posts = [];
	for (const post of allPosts) {
		if (posts.length >= count) break;
		if (!displayedPosts.has(post.id) && filterFn(post)) {
			posts.push(post);
			displayedPosts.add(post.id);
		}
	}
	return posts;
}

// 1. Destaque (Prioriza featured === true, senão pega o mais recente)
let featuredPost = getPosts(1, (p) => p.data.featured === true)[0];
if (!featuredPost) {
	featuredPost = getPosts(1, () => true)[0]; // Fallback para o mais recente
}

// 2. Aprenda Antes de Comprar (Informacional)
const informationalPosts = getPosts(3, (p) => {
	if (p.data.articleType === 'informational') return true;
	// Inferência temporária
	const titleLower = p.data.title.toLowerCase();
	return titleLower.includes('o que é') || titleLower.includes('como ') || titleLower.includes('vale a pena');
});

// 3. Comparativos
const comparisonPosts = getPosts(3, (p) => {
	if (p.data.articleType === 'comparison') return true;
	// Inferência temporária
	return p.data.title.toLowerCase().includes(' vs ');
});

// 4. Guias de Compra
const guidePosts = getPosts(3, (p) => {
	if (p.data.articleType === 'guide') return true;
	// Inferência temporária
	return p.data.title.toLowerCase().includes('melhores') || (p.data.tags && p.data.tags.includes('oferta'));
});

// 5. Recentes (Qualquer post que sobrou)
const recentPosts = getPosts(6, () => true);

const categories = [
	{ name: '📱 Celulares', slug: 'celulares' },
	{ name: '💻 Computadores', slug: 'hardware' },
	{ name: '🎮 Games', slug: 'games' },
	{ name: '🏠 Casa', slug: 'eletrodomesticos' },
	{ name: '📺 TV & Imagem', slug: 'tv-e-imagem' },
	{ name: '🎧 Áudio', slug: 'audio' },
	{ name: '📡 Redes & Wi-Fi', slug: 'redes-e-wi-fi' },
	{ name: '🔌 Acessórios', slug: 'acessorios' },
];
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 100%;
				max-width: 1080px;
				margin: 0 auto;
				padding: 0 1rem;
				box-sizing: border-box;
			}
			/* Hero */
			.hero {
				text-align: center;
				padding: 4.5em 0 3.5em 0;
				margin-bottom: 2em;
				border-bottom: 1px solid rgba(255, 255, 255, 0.05);
			}
			.hero h1 {
				font-size: 3.8em;
				margin-bottom: 0.2em;
				background: linear-gradient(to right, #F8FAFC, var(--accent));
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				line-height: 1.1;
			}
			.hero p {
				font-size: 1.25em;
				color: var(--text-muted);
				max-width: 700px;
				margin: 0 auto 2rem auto;
				line-height: 1.6;
			}
			.hero-ctas {
				display: flex;
				gap: 1rem;
				justify-content: center;
				flex-wrap: wrap;
			}
			.btn-primary {
				background-color: var(--accent);
				color: var(--bg-dark);
				padding: 0.8rem 1.8rem;
				border-radius: 8px;
				font-weight: 800;
				text-decoration: none;
				text-transform: uppercase;
				letter-spacing: 0.5px;
				transition: all 0.2s ease;
			}
			.btn-primary:hover {
				background-color: var(--accent-dark);
				transform: translateY(-2px);
			}
			.btn-secondary {
				background-color: transparent;
				color: var(--accent);
				border: 1px solid var(--accent);
				padding: 0.8rem 1.8rem;
				border-radius: 8px;
				font-weight: 800;
				text-decoration: none;
				text-transform: uppercase;
				letter-spacing: 0.5px;
				transition: all 0.2s ease;
			}
			.btn-secondary:hover {
				background-color: rgba(0, 229, 255, 0.1);
				transform: translateY(-2px);
			}

			/* Diferenciais */
			.diferenciais {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
				gap: 2rem;
				margin-bottom: 4rem;
				text-align: center;
			}
			.diferencial-item h3 {
				color: var(--text-main);
				font-size: 1.3rem;
				margin-bottom: 0.5rem;
			}
			.diferencial-item p {
				color: var(--text-muted);
				font-size: 0.95rem;
				margin: 0;
			}

			/* Categorias */
			.categories-grid {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 1rem;
				margin-bottom: 4rem;
			}
			.category-pill {
				background-color: var(--bg-card);
				border: 1px solid rgba(255, 255, 255, 0.05);
				padding: 1rem;
				border-radius: 12px;
				text-align: center;
				text-decoration: none;
				color: var(--text-main);
				font-weight: 600;
				transition: all 0.2s;
			}
			.category-pill:hover {
				border-color: var(--accent);
				transform: translateY(-3px);
				box-shadow: 0 4px 15px rgba(0, 229, 255, 0.1);
			}

			/* Utilidades de Seção */
			.section-title {
				margin-bottom: 1.5em;
				font-size: 1.6em;
				color: var(--text-main);
				border-left: 4px solid var(--accent);
				padding-left: 15px;
			}
			section {
				margin-bottom: 4rem;
			}

			/* Featured Article */
			.featured-article {
				display: grid;
				grid-template-columns: 3fr 2fr;
				gap: 2rem;
				background-color: var(--bg-card);
				border-radius: 12px;
				overflow: hidden;
				border: 1px solid var(--accent);
				transition: all 0.3s ease;
			}
			.featured-article:hover {
				box-shadow: 0 4px 20px rgba(0, 229, 255, 0.15);
				transform: translateY(-3px);
			}
			.featured-article img {
				width: 100%;
				height: 100%;
				min-height: 300px;
				object-fit: cover;
			}
			.featured-content {
				padding: 2rem 2rem 2rem 0;
				display: flex;
				flex-direction: column;
				justify-content: center;
			}
			.featured-content a {
				text-decoration: none;
			}
			.featured-content .title {
				font-size: 1.8rem;
				margin: 0.5rem 0 1rem 0;
				color: var(--text-main);
				line-height: 1.3;
			}
			.featured-content p.description {
				color: var(--text-muted);
				line-height: 1.6;
				margin-bottom: 1.5rem;
				font-size: 0.95rem;
			}

			/* Grid de Posts Genérico */
			ul.posts-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
				gap: 1.5rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul.posts-grid li {
				background-color: var(--bg-card);
				border-radius: 12px;
				overflow: hidden;
				border: 1px solid rgba(255, 255, 255, 0.05);
				transition: all 0.3s ease;
				display: flex;
				flex-direction: column;
			}
			ul.posts-grid li:hover {
				transform: translateY(-5px);
				border-color: var(--accent);
				box-shadow: 0 4px 15px rgba(0, 229, 255, 0.1);
			}
			ul.posts-grid li a.card-link {
				display: flex;
				flex-direction: column;
				height: 100%;
				text-decoration: none;
			}
			ul.posts-grid li img {
				width: 100%;
				height: 180px;
				object-fit: cover;
				border-bottom: 1px solid rgba(255, 255, 255, 0.05);
			}
			.card-content {
				padding: 1.2rem;
				flex-grow: 1;
				display: flex;
				flex-direction: column;
			}
			.category-tag {
				display: inline-block;
				font-size: 0.75rem;
				font-weight: 700;
				text-transform: uppercase;
				color: var(--bg-dark);
				background-color: var(--accent);
				padding: 0.2em 0.6em;
				border-radius: 4px;
				align-self: flex-start;
				margin-bottom: 0.6em;
			}
			.title {
				margin: 0 0 0.8rem 0;
				font-size: 1.1rem;
				line-height: 1.3;
				color: var(--text-main);
				flex-grow: 1;
			}
			.date {
				margin: 0 0 1rem 0;
				color: var(--text-muted);
				font-size: 0.8em;
			}
			.read-more-link {
				color: var(--accent);
				font-weight: 700;
				font-size: 0.85em;
				display: inline-flex;
				align-items: center;
				gap: 4px;
			}

			/* Banner de Ofertas e Newsletter */
			.banner-box {
				background: linear-gradient(135deg, rgba(0, 229, 255, 0.05) 0%, rgba(15, 23, 42, 0.8) 100%);
				border: 1px solid var(--accent);
				border-radius: 12px;
				padding: 3rem 2rem;
				text-align: center;
				margin-bottom: 4rem;
			}
			.banner-box h2 {
				font-size: 1.5rem;
				color: var(--text-main);
				margin-bottom: 0.5rem;
			}
			.banner-box p {
				color: var(--text-muted);
				margin-bottom: 1.5rem;
			}

			@media (max-width: 768px) {
				.featured-article {
					grid-template-columns: 1fr;
				}
				.featured-content {
					padding: 1.5rem;
				}
				.featured-article img {
					height: 220px;
					min-height: auto;
				}
				.hero h1 {
					font-size: 2.5em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			{/* 1. HERO */}
			<section class="hero">
				<h1>Descubra. Compare. Escolha melhor.</h1>
				<p>Conteúdo, análises, comparativos e guias para ajudar você a encontrar produtos que realmente valem a pena.</p>
				<div class="hero-ctas">
					<a href="/guias-de-compra/" class="btn-primary">Explorar Guias de Compra</a>
					<a href="/comparativos/" class="btn-secondary">Ver Comparativos</a>
				</div>
			</section>

			{/* 2. DIFERENCIAIS */}
			<section class="diferenciais">
				<div class="diferencial-item">
					<h3>🔎 INFORMAÇÃO</h3>
					<p>Entenda antes de comprar.</p>
				</div>
				<div class="diferencial-item">
					<h3>⚔️ COMPARAÇÃO</h3>
					<p>Veja as diferenças que realmente importam.</p>
				</div>
				<div class="diferencial-item">
					<h3>⭐ RECOMENDAÇÃO</h3>
					<p>Descubra o que faz sentido para você.</p>
				</div>
			</section>

			{/* 3. CATEGORIAS */}
			<section>
				<h2 class="section-title">O que você está procurando?</h2>
				<div class="categories-grid">
					{categories.map((cat) => (
						<CategoryCard name={cat.name} slug={cat.slug} />
					))}
				</div>
			</section>

			{/* 4. DESTAQUE */}
			{featuredPost && (
				<section>
					<h2 class="section-title">🔥 Em destaque</h2>
					<article class="featured-article">
						<a href={`/blog/${featuredPost.id}/`}>
							{featuredPost.data.heroImage && (
								<Image width={800} height={400} src={featuredPost.data.heroImage} alt={featuredPost.data.title} />
							)}
						</a>
						<div class="featured-content">
							<a href={`/blog/${featuredPost.id}/`}>
								{featuredPost.data.category && <span class="category-tag">{featuredPost.data.category}</span>}
								<h3 class="title">{featuredPost.data.title}</h3>
								<p class="date"><FormattedDate date={featuredPost.data.pubDate} /></p>
								<p class="description">{featuredPost.data.description}</p>
								<span class="read-more-link">Ler análise →</span>
							</a>
						</div>
					</article>
				</section>
			)}

			{/* 5. APRENDA ANTES DE COMPRAR */}
			{informationalPosts.length > 0 && (
				<section>
					<h2 class="section-title">📚 Aprenda antes de comprar</h2>
					<ul class="posts-grid">
						{informationalPosts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`} class="card-link">
									{post.data.heroImage && (
										<Image width={400} height={200} src={post.data.heroImage} alt={post.data.title} />
									)}
									<div class="card-content">
										{post.data.category && <span class="category-tag">{post.data.category}</span>}
										<h3 class="title">{post.data.title}</h3>
										<p class="date"><FormattedDate date={post.data.pubDate} /></p>
										<span class="read-more-link">Ler artigo →</span>
									</div>
								</a>
							</li>
						))}
					</ul>
				</section>
			)}

			{/* 6. COMPARATIVOS */}
			{comparisonPosts.length > 0 && (
				<section>
					<h2 class="section-title">⚔️ Comparativos</h2>
					<ul class="posts-grid">
						{comparisonPosts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`} class="card-link">
									{post.data.heroImage && (
										<Image width={400} height={200} src={post.data.heroImage} alt={post.data.title} />
									)}
									<div class="card-content">
										{post.data.category && <span class="category-tag">{post.data.category}</span>}
										<h3 class="title">{post.data.title}</h3>
										<p class="date"><FormattedDate date={post.data.pubDate} /></p>
										<span class="read-more-link">Ver comparativo →</span>
									</div>
								</a>
							</li>
						))}
					</ul>
				</section>
			)}

			{/* 7. GUIAS DE COMPRA */}
			{guidePosts.length > 0 && (
				<section>
					<h2 class="section-title">🛒 Guias de Compra</h2>
					<ul class="posts-grid">
						{guidePosts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`} class="card-link">
									{post.data.heroImage && (
										<Image width={400} height={200} src={post.data.heroImage} alt={post.data.title} />
									)}
									<div class="card-content">
										{post.data.category && <span class="category-tag">{post.data.category}</span>}
										<h3 class="title">{post.data.title}</h3>
										<p class="date"><FormattedDate date={post.data.pubDate} /></p>
										<span class="read-more-link">Ver guia →</span>
									</div>
								</a>
							</li>
						))}
					</ul>
				</section>
			)}

			{/* 8. CONTEÚDOS RECENTES */}
			{recentPosts.length > 0 && (
				<section>
					<h2 class="section-title">Últimas atualizações</h2>
					<ul class="posts-grid">
						{recentPosts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`} class="card-link">
									{post.data.heroImage && (
										<Image width={400} height={200} src={post.data.heroImage} alt={post.data.title} />
									)}
									<div class="card-content">
										{post.data.category && <span class="category-tag">{post.data.category}</span>}
										<h3 class="title">{post.data.title}</h3>
										<p class="date"><FormattedDate date={post.data.pubDate} /></p>
										<span class="read-more-link">Ler artigo →</span>
									</div>
								</a>
							</li>
						))}
					</ul>
				</section>
			)}

			{/* 9. OFERTAS */}
			<section class="banner-box">
				<h2>Encontrou o que procurava?</h2>
				<p>Confira nossa seleção de ofertas verificadas de produtos que recomendamos.</p>
				<a href="/ofertas/" class="btn-primary">Ver Ofertas Atuais</a>
			</section>

			{/* 10. NEWSLETTER */}
			<section class="banner-box" style="margin-bottom: 2rem; background: var(--bg-card);">
				<h2>Quer descobrir boas oportunidades?</h2>
				<p>Receba novos guias, comparativos e descobertas do Nikezin Indica.</p>
				<form class="newsletter-form" style="display: flex; gap: 1rem; justify-content: center; max-width: 500px; margin: 0 auto; flex-wrap: wrap;">
					<input type="email" placeholder="Seu melhor e-mail" aria-label="E-mail para newsletter" style="flex: 1; min-width: 200px; padding: 0.8rem; border-radius: 8px; border: 1px solid rgba(255,255,255,0.1); background: var(--bg-dark); color: white;" />
					<button type="button" class="btn-secondary" style="cursor: pointer;">Inscrever-se</button>
				</form>
			</section>
		</main>
		<Footer />
	</body>
</html>
