---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

// Ordena todos os posts do blog por pubDate (do mais recente para o mais antigo)
const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// O destaque é estritamente o artigo mais recente
const featuredPost = allPosts[0];

// Artigos recentes: os próximos 8 artigos, excluindo estritamente o post em destaque
const recentPosts = allPosts
	.filter((post) => post.id !== featuredPost?.id)
	.slice(0, 8);
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 100%;
				max-width: 1080px;
				margin: 0 auto;
				padding: 0 1rem;
				box-sizing: border-box;
			}
			.hero {
				text-align: center;
				padding: 3.5em 0 2.5em 0;
				margin-bottom: 2.5em;
				border-bottom: 1px solid rgba(255, 255, 255, 0.05);
			}
			.hero h1 {
				font-size: 3.8em;
				margin-bottom: 0.2em;
				background: linear-gradient(to right, #F8FAFC, var(--accent));
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
			}
			.hero p {
				font-size: 1.15em;
				color: var(--text-muted);
				max-width: 650px;
				margin: 0 auto;
				line-height: 1.6;
			}
			.section-title {
				margin-bottom: 1.5em;
				font-size: 1.6em;
				color: var(--text-main);
				border-left: 4px solid var(--accent);
				padding-left: 15px;
			}
			
			/* Featured Article */
			.featured-article {
				display: grid;
				grid-template-columns: 3fr 2fr;
				gap: 2rem;
				background-color: var(--bg-card);
				border-radius: 12px;
				overflow: hidden;
				border: 1px solid var(--accent);
				margin-bottom: 4rem;
				transition: all 0.3s ease;
			}
			.featured-article:hover {
				box-shadow: var(--box-shadow);
				transform: translateY(-3px);
			}
			.featured-article img {
				width: 100%;
				height: 100%;
				min-height: 300px;
				object-fit: cover;
			}
			.featured-content {
				padding: 2rem 2rem 2rem 0;
				display: flex;
				flex-direction: column;
				justify-content: center;
			}
			.featured-content a {
				text-decoration: none;
			}
			.featured-content .title {
				font-size: 1.8rem;
				margin: 0.5rem 0 1rem 0;
				color: var(--text-main);
				line-height: 1.3;
			}
			.featured-content p.description {
				color: var(--text-muted);
				line-height: 1.6;
				margin-bottom: 1.5rem;
				font-size: 0.95rem;
			}

			/* Grid de Recentes */
			ul.posts-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
				gap: 1.5rem;
				list-style-type: none;
				margin: 0 0 3rem 0;
				padding: 0;
			}
			ul.posts-grid li {
				background-color: var(--bg-card);
				border-radius: 12px;
				overflow: hidden;
				border: 1px solid rgba(255, 255, 255, 0.05);
				transition: all 0.3s ease;
				display: flex;
				flex-direction: column;
			}
			ul.posts-grid li:hover {
				transform: translateY(-5px);
				border-color: var(--accent);
				box-shadow: var(--box-shadow);
			}
			ul.posts-grid li a.card-link {
				display: flex;
				flex-direction: column;
				height: 100%;
				text-decoration: none;
			}
			ul.posts-grid li img {
				width: 100%;
				height: 180px;
				object-fit: cover;
				border-bottom: 1px solid rgba(255, 255, 255, 0.05);
			}
			.card-content {
				padding: 1.2rem;
				flex-grow: 1;
				display: flex;
				flex-direction: column;
			}
			.category-tag {
				display: inline-block;
				font-size: 0.75rem;
				font-weight: 700;
				text-transform: uppercase;
				color: var(--bg-dark);
				background-color: var(--accent);
				padding: 0.2em 0.6em;
				border-radius: 4px;
				align-self: flex-start;
				margin-bottom: 0.6em;
			}
			.title {
				margin: 0 0 0.8rem 0;
				font-size: 1.1rem;
				line-height: 1.3;
				color: var(--text-main);
				flex-grow: 1;
			}
			.date {
				margin: 0 0 1rem 0;
				color: var(--text-muted);
				font-size: 0.8em;
			}
			.read-more-link {
				color: var(--accent);
				font-weight: 700;
				font-size: 0.85em;
				display: inline-flex;
				align-items: center;
				gap: 4px;
			}

			/* CTA Seção Blog */
			.blog-cta-box {
				text-align: center;
				background-color: var(--bg-card);
				border-radius: 12px;
				padding: 3rem 1.5rem;
				border: 1px solid rgba(255, 255, 255, 0.05);
				margin-bottom: 4rem;
			}
			.blog-cta-box h3 {
				font-size: 1.5rem;
				color: var(--text-main);
				margin-bottom: 0.5rem;
			}
			.blog-cta-box p {
				color: var(--text-muted);
				margin-bottom: 1.5rem;
			}
			.btn-cta {
				display: inline-block;
				background-color: var(--accent);
				color: var(--bg-dark);
				padding: 0.8rem 1.8rem;
				border-radius: 8px;
				font-weight: 800;
				text-decoration: none;
				text-transform: uppercase;
				letter-spacing: 0.5px;
				transition: all 0.2s ease;
				box-shadow: 0 0 15px rgba(0, 229, 255, 0.3);
			}
			.btn-cta:hover {
				background-color: var(--accent-dark);
				transform: translateY(-2px);
				box-shadow: 0 0 25px rgba(0, 229, 255, 0.6);
			}
			
			section {
				margin-bottom: 3.5rem;
			}

			@media (max-width: 768px) {
				.featured-article {
					grid-template-columns: 1fr;
				}
				.featured-content {
					padding: 1.5rem;
				}
				.featured-article img {
					height: 220px;
					min-height: auto;
				}
				.hero h1 {
					font-size: 2.5em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>Nikezin Indica</h1>
				<p>Curadoria de tecnologia, guias de compra e análises para ajudar você a escolher melhor seus próximos upgrades.</p>
			</section>

			{featuredPost && (
				<section>
					<h2 class="section-title">Em Destaque</h2>
					<article class="featured-article">
						<a href={`/blog/${featuredPost.id}/`}>
							{featuredPost.data.heroImage && (
								<Image width={800} height={400} src={featuredPost.data.heroImage} alt={featuredPost.data.title} />
							)}
						</a>
						<div class="featured-content">
							<a href={`/blog/${featuredPost.id}/`}>
								{featuredPost.data.category && <span class="category-tag">{featuredPost.data.category}</span>}
								<h3 class="title">{featuredPost.data.title}</h3>
								<p class="date"><FormattedDate date={featuredPost.data.pubDate} /></p>
								<p class="description">{featuredPost.data.description}</p>
								<span class="read-more-link">Ler artigo →</span>
							</a>
						</div>
					</article>
				</section>
			)}

			{recentPosts.length > 0 && (
				<section>
					<h2 class="section-title">Artigos Recentes</h2>
					<ul class="posts-grid">
						{
							recentPosts.map((post) => (
								<li>
									<a href={`/blog/${post.id}/`} class="card-link">
										{post.data.heroImage && (
											<Image width={400} height={200} src={post.data.heroImage} alt={post.data.title} />
										)}
										<div class="card-content">
											{post.data.category && <span class="category-tag">{post.data.category}</span>}
											<h4 class="title">{post.data.title}</h4>
											<p class="date">
												<FormattedDate date={post.data.pubDate} />
											</p>
											<span class="read-more-link">Ler artigo →</span>
										</div>
									</a>
								</li>
							))
						}
					</ul>
				</section>
			)}

			<section class="blog-cta-box">
				<h3>Quer explorar todo o conteúdo?</h3>
				<p>Acesse nossa biblioteca completa com reviews, comparativos e guias técnicos.</p>
				<a href="/blog/" class="btn-cta">Ver todos os artigos →</a>
			</section>
		</main>
		<Footer />
	</body>
</html>
