---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

// Pega todos os posts do blog
const allPosts = await getCollection('blog');

// Filtra estritamente apenas os conteúdos comerciais que possuem ofertas/produtos reais (tag 'oferta')
const offerPosts = allPosts
	.filter(post => post.data.tags && post.data.tags.includes('oferta'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<BaseHead 
			title={`Ofertas de Hardware e Eletrônicos - ${SITE_TITLE}`} 
			description="Produtos e oportunidades de hardware e tecnologia selecionados pelo Nikezin Indica, com foco em custo-benefício e boas oportunidades de compra." 
		/>
		<style>
			main {
				width: 100%;
				max-width: 1080px;
				margin: 0 auto;
				padding: 0 1rem;
				box-sizing: border-box;
			}
			.page-title {
				text-align: center;
				margin-bottom: 0.3em;
				color: var(--text-main);
			}
			.page-subtitle {
				text-align: center;
				color: var(--text-muted);
				margin-bottom: 2em;
				font-size: 1.1em;
			}
			.affiliate-disclaimer {
				background: rgba(0, 229, 255, 0.05);
				border: 1px solid rgba(0, 229, 255, 0.2);
				border-radius: 8px;
				padding: 0.8rem 1.2rem;
				margin-bottom: 2.5rem;
				font-size: 0.88em;
				color: var(--text-muted);
				text-align: center;
			}
			ul {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
				gap: 1.5rem;
				list-style-type: none;
				margin: 0 0 3rem 0;
				padding: 0;
			}
			ul li {
				background-color: var(--bg-card);
				border-radius: 12px;
				overflow: hidden;
				border: 1px solid rgba(255, 255, 255, 0.05);
				transition: all 0.3s ease;
				display: flex;
				flex-direction: column;
			}
			ul li:hover {
				transform: translateY(-5px);
				border-color: var(--accent);
				box-shadow: var(--box-shadow);
			}
			ul li a.card-link {
				display: flex;
				flex-direction: column;
				height: 100%;
				text-decoration: none;
			}
			ul li img {
				width: 100%;
				height: 180px;
				object-fit: cover;
				border-bottom: 1px solid rgba(255, 255, 255, 0.05);
			}
			.card-content {
				padding: 1.2rem;
				flex-grow: 1;
				display: flex;
				flex-direction: column;
			}
			.category-badge {
				font-size: 0.75rem;
				text-transform: uppercase;
				letter-spacing: 0.5px;
				color: var(--accent);
				font-weight: 700;
				margin-bottom: 0.5rem;
			}
			.title {
				margin: 0 0 1rem 0;
				font-size: 1.1rem;
				line-height: 1.3;
				color: var(--text-main);
				flex-grow: 1;
			}
			.cta-badge {
				display: block;
				text-align: center;
				background-color: rgba(0, 229, 255, 0.1);
				color: var(--accent);
				padding: 0.6rem;
				border-radius: 6px;
				font-weight: 800;
				text-transform: uppercase;
				font-size: 0.85em;
				transition: all 0.2s ease;
			}
			ul li:hover .cta-badge {
				background-color: var(--accent);
				color: var(--bg-dark);
			}
			.empty-state {
				text-align: center;
				padding: 4rem 1rem;
				background: var(--bg-card);
				border-radius: 12px;
				border: 1px solid rgba(255, 255, 255, 0.05);
				margin-bottom: 3rem;
			}
			.empty-state h3 {
				color: var(--text-main);
				margin-bottom: 0.5rem;
			}
			.empty-state p {
				color: var(--text-muted);
				max-width: 500px;
				margin: 0 auto;
			}
			@media (max-width: 720px) {
				ul {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1 class="page-title">Ofertas de Hardware e Eletrônicos</h1>
			<p class="page-subtitle">Produtos e oportunidades que valem a pena acompanhar, selecionados pelo Nikezin Indica.</p>
			
			<div class="affiliate-disclaimer">
				ℹ️ Alguns links desta página são links de afiliados. Podemos receber uma comissão por compras qualificadas, sem custo adicional para você.
			</div>

			<section>
				{
					offerPosts.length > 0 ? (
						<ul>
							{
								offerPosts.map((post) => (
									<li>
										<a href={`/blog/${post.id}/`} class="card-link">
											{post.data.heroImage && (
												<Image width={720} height={360} src={post.data.heroImage} alt={post.data.title} />
											)}
											<div class="card-content">
												{post.data.category && (
													<span class="category-badge">{post.data.category}</span>
												)}
												<h3 class="title">{post.data.title}</h3>
												<span class="cta-badge">Ver Produtos & Ofertas 🛒</span>
											</div>
										</a>
									</li>
								))
							}
						</ul>
					) : (
						<div class="empty-state">
							<h3>Ofertas selecionadas</h3>
							<p>Encontramos produtos e oportunidades que realmente fazem sentido para o seu setup. Os preços e a disponibilidade podem mudar conforme a loja.</p>
						</div>
					)
				}
			</section>
		</main>
		<Footer />
	</body>
</html>
