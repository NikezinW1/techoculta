---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import { SITE_TITLE } from '../consts';

// Pega todos os posts do blog
const allPosts = await getCollection('blog');

// Filtra estritamente apenas os conteúdos comerciais que possuem ofertas/produtos reais (tag 'oferta')
const offerPosts = allPosts
	.filter(post => post.data.tags && post.data.tags.includes('oferta'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<BaseHead 
			title={`Ofertas de Hardware e Eletrônicos - ${SITE_TITLE}`} 
			description="Produtos e oportunidades de hardware e tecnologia selecionados pelo Nikezin Indica, com foco em custo-benefício e boas oportunidades de compra." 
		/>
		<style>
			main {
				width: 100%;
				max-width: 1080px;
				margin: 0 auto;
				padding: 0 1rem;
				box-sizing: border-box;
			}
			.page-title {
				text-align: center;
				margin-bottom: 0.3em;
				color: var(--text-main);
			}
			.page-subtitle {
				text-align: center;
				color: var(--text-muted);
				margin-bottom: 2em;
				font-size: 1.1em;
			}
			.affiliate-disclaimer {
				display: flex;
				align-items: flex-start;
				gap: 0.6rem;
				background: var(--accent-soft);
				border: 1px solid var(--line-strong);
				border-radius: var(--radius-m);
				padding: 0.9rem 1.2rem;
				margin-bottom: 2.5rem;
				font-size: 0.88em;
				color: var(--text-soft);
				text-align: left;
				line-height: 1.6;
			}
			.affiliate-disclaimer svg {
				flex-shrink: 0;
				margin-top: 0.15rem;
				color: var(--accent);
			}
			.empty-state {
				text-align: center;
				padding: 4rem 1rem;
				background: var(--bg-card);
				border-radius: var(--radius-l);
				border: 1px solid var(--line-subtle);
				margin-bottom: 3rem;
			}
			.empty-state h3 {
				color: var(--text-main);
				margin-bottom: 0.5rem;
			}
			.empty-state p {
				color: var(--text-muted);
				max-width: 500px;
				margin: 0 auto;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1 class="page-title">Ofertas de Hardware e Eletrônicos</h1>
			<p class="page-subtitle">Produtos e oportunidades que valem a pena acompanhar, selecionados pelo Nikezin Indica.</p>
			
			<div class="affiliate-disclaimer">
				<Icon name="info" size={18} />
				<span>Alguns links desta página são links de afiliados. Podemos receber uma comissão por compras qualificadas, sem custo adicional para você.</span>
			</div>

			<section>
				{
					offerPosts.length > 0 ? (
						<ul class="articles-grid">
							{
								offerPosts.map((post, index) => (
									<li class={`article-card${index === 0 ? ' article-card--lead' : ''}`}>
										<a href={`/blog/${post.id}/`}>
											<div class="article-card__media">
												{post.data.heroImage && (
													<Image width={720} height={360} src={post.data.heroImage} alt={post.data.title} />
												)}
											</div>
											<div class="article-card__body">
												{post.data.category && (
													<span class="tag">{post.data.category}</span>
												)}
												<h3 class="article-card__title">{post.data.title}</h3>
												<span class="card-cta">Ver Produtos & Ofertas <Icon name="arrowRight" size={14} /></span>
											</div>
										</a>
									</li>
								))
							}
						</ul>
					) : (
						<div class="empty-state">
							<h3>Ofertas selecionadas</h3>
							<p>Encontramos produtos e oportunidades que realmente fazem sentido para o seu setup. Os preços e a disponibilidade podem mudar conforme a loja.</p>
						</div>
					)
				}
			</section>
		</main>
		<Footer />
	</body>
</html>